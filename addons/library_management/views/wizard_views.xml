<odoo>
    <record id="view_library_rent_wizard_form" model="ir.ui.view">
        <field name="name">library.rent.wizard.form</field>
        <field name="model">library.rent.wizard</field>
        <field name="arch" type="xml">
            <form string="Rent Book">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="book_id" invisible="1"/>
                    </group>
                    <footer>
                        <button string="Confirm" type="object" name="action_confirm_rent" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>